# Copy this file to .env and fill in only the providers you use.
# Never commit .env.

# Required for all three agents
ANTHROPIC_API_KEY=
# Model ID used by the agents (no default is hardcoded)
ANTHROPIC_MODEL=

# Required for Agent 2 (Pesquisador)
SERPER_API_KEY=

# Optional providers (not used yet)
APIFY_TOKEN=
TAVILY_API_KEY=

# Optional settings (defaults shown)
SEARCH_PROVIDER=serper
LOG_LEVEL=info
MAX_CONCURRENCY=3
DEFAULT_BATCH_LIMIT=5
